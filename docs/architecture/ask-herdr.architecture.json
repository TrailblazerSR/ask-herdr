  "cards": [
    {
      "dot": "rose",
      "title": "Private in",
      "items": [
        "Owner supplies only a canonical request path",
        "Project root, Authority UUID, request JSON, and validation output stay private"
      ]
    },
    {
      "dot": "emerald",
      "title": "Authenticated local read",
      "items": [
        "Authority, Lane, and Topology projections must form one stable epoch",
        "Observation is metadata-only and does not repair or mutate stores"
      ]
    },
    {
      "dot": "cyan",
      "title": "Public out",
      "items": [
        "Only query.status executes",
        "No provider, Herdr, network service, hosted backend, or remote/HPC action"
      ]
    }
